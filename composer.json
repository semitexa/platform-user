{
    "name": "semitexa/platform-user",
    "description": "Semitexa Platform User - the identity store: users, password credentials, roles and tenant binding behind the auth contracts",
    "type": "semitexa-module",
    "license": "MIT",
    "authors": [
        {
            "name": "Semitexa",
            "email": "support@semitexa.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "semitexa/core": ">=2026.10.29.1052 || dev-master",
        "semitexa/auth": ">=2026.10.29.1052 || dev-master",
        "semitexa/orm": ">=2026.10.29.1052 || dev-master",
        "semitexa/rbac": "*",
        "semitexa/mail": ">=2026.10.29.1052 || dev-master"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Semitexa\\Platform\\User\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Semitexa\\Platform\\User\\Tests\\": "tests/"
        }
    },
    "extra": {
        "semitexa-module": {
            "name": "platform-user",
            "description": "Identity store: users, password credentials, roles, tenant binding"
        },
        "semitexa": {
            "floors": {
                "semitexa/auth": "2026.10.29.1052",
                "semitexa/mail": "2026.10.29.1052",
                "semitexa/core": "2026.10.29.1052",
                "semitexa/orm": "2026.10.29.1052"
            }
        }
    },
    "keywords": [
        "semitexa",
        "user",
        "identity",
        "authentication",
        "password"
    ]
}
